
from openai import OpenAI
from dotenv import load_dotenv
import os

# Load environment variables from .env
load_dotenv()

# Get API key,from environment variable.env
api_key = os.getenv("OPENAI_API_KEY")

# Initialize client
client = OpenAI(api_key=api_key)

prompt_zero = """Classify the sentiment of each review from 1 to 5 (1=very negative, 5=very positive):
1. Unbelievably good!
2. Shoes fell apart on the second use.
3. The shoes look nice, but they aren't very comfortable.
4. Can't wait to show them off!
"""

response_zero = client.chat.completions.create(
    model="gpt-4o-mini",
    messages=[{"role": "user", "content": prompt_zero}],
    max_tokens=100
)

print("Zero-shot result:\n", response_zero.choices[0].message.content)